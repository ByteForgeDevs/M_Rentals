{
  "name": "mrentals",
  "version": "1.0.0",
  "private": true,
  "description": "Mrentals: a trust-first rental marketplace for Kenya",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --watch",
    "postinstall": "node ./scripts/vendor-htmx.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16"
  },
  "dependencies": {
    "htmx.org": "^1.9.12"
  }
}
