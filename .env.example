# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the bundled SQLite database.
# DATABASE_URL=postgresql://user:password@localhost:5432/mrentals

# Production only. Render sets RENDER_EXTERNAL_HOSTNAME itself, so the host and
# CSRF origin settings above do not need editing there.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mrentals.onrender.com
# DJANGO_MEDIA_ROOT=/var/data/media
# DJANGO_SERVE_MEDIA_FILES=True
# DJANGO_SECURE_SSL_REDIRECT=True
